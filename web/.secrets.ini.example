; Tajomstvá pre PHP na Websupporte (surfspirit.sk/web/.secrets.ini).
; Súbor .secrets.ini je v .htaccess zakázaný verejnosti a v repe je len táto šablóna.
; Číta ho api.php (menu, eventy) aj objednavky-api.php (objednávky s doručením).

[neon]
host = ep-xxx.neon.tech
port = 5432
dbname = neondb
user =
password =

[wolt]
; Token a venue od Wolt Drive — používa ich LEN výpočet ceny doručenia (shipment promise).
; Kuriéra objednáva kasa zo svojho .env (WOLT_*). Režim (mock/development/production)
; sem NEpíš — určuje ho kasa cez web_delivery_config.
token =
venue_id =
merchant_id =
; client_secret zadaný pri registrácii webhooku (scripts/wolt-register-webhook.mjs);
; rovnaký ako WOLT_WEBHOOK_SECRET na kase.
webhook_secret =
; Wolt Order API (objednávky z aplikácie Wolt): client secret webhooku, hlavička
; WOLT-SIGNATURE; rovnaký ako WOLT_ORDER_WEBHOOK_SECRET na kase.
order_webhook_secret =
