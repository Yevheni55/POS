DATABASE_URL=postgresql://pos:pos@localhost:5432/pos
JWT_SECRET=change-me-in-production
PORT=3080
# Otvorenie POS z telefonu/tabletu v domacej WiFi (Origin http://192.168.x.x:3080) — inak API zablokuje CORS.
# Opt-in: default je false (POS prístupný iba zo localhost). Nastav true iba ak potrebuješ LAN prístup.
CORS_ALLOW_LAN=false
# Čiarkou oddelený zoznam portov, ktoré sú v LAN whitelisted keď CORS_ALLOW_LAN=true.
# Default 3080,3443 = HTTP a HTTPS POS port. Ostatné porty z RFC-1918 adries sú odmietnuté.
LAN_ALLOWED_PORTS=3080,3443
PRINTER_IP=192.168.0.107
PRINTER_PORT=9100
PORTOS_ENABLED=false
# PORTOS_BASE_URL:
# - `node server.js` na tom istom PC ako Portos: http://localhost:3010
# - Docker: hodnotu nastavuje docker-compose.yml (predvolené http://host.docker.internal:3010 = Portos na hostiteľovi
#   Windows/Mac). Kľúč PORTOS_BASE_URL v tomto súbore v kontajneri compose PREPÍŠE — na zmenu URL pre Docker
#   použi súbor `.env` v koreni repozitára (vedľa docker-compose.yml), napr. PORTOS_BASE_URL=http://192.168.0.15:3010
#   ak je Portos na inom stroji alebo host.docker.internal nefunguje.
PORTOS_BASE_URL=http://localhost:3010
PORTOS_CASH_REGISTER_CODE=88812345678900001
# Nie nazov zariadenia vo Windows! API NineDigit: pos = papier/CHDU, pdf, email
PORTOS_PRINTER_NAME=pos
PORTOS_TIMEOUT_MS=10000
# OČAKÁVANÝ režim DPH — druhý nezávislý zdroj popri `company_profiles.ic_dph`,
# ktorý sa plní z Portos identity. Server ich porovnáva (server/lib/vat-registration.js):
#   • zhoda      → režim je potvrdený a fiškalizuje sa aj vtedy, keď Portos profile
#                  sync ešte nedobehol (bez tejto hodnoty POS pri výpadku čaká 5 s
#                  na inline sync a potom vráti 503 „nepodarilo sa overiť režim DPH");
#   • rozpor     → WARN do logu a fiškálne cesty ostávajú fail-closed.
# Hodnoty: true/1/yes/on = firma JE platiteľ DPH, false/0/no/off = neplatiteľ.
# Prázdne = nekontroluje sa (nechávaj tak len na dev stroji bez Portosu).
# Na kase platiteľa DPH (SL management, s.r.o., IČ DPH SK2121741842) MUSÍ byť
# `true` — inak by pri nedostupnom Portose išli doklady s 0 % DPH, čo je pre
# platiteľa nesprávna daň, alebo by sa nevystavili vôbec.
POS_VAT_REGISTERED=false
# Denný export sezónneho P&L do Google Sheets (05:10 Bratislava). Webhook =
# Apps Script Web App URL (návod v scripts/sheets-export-webhook.gs). Prázdne
# SHEETS_EXPORT_URL = export vypnutý. TOKEN musí sedieť s TOKEN v Apps Scripte.
SHEETS_EXPORT_URL=
SHEETS_EXPORT_TOKEN=
SHEETS_EXPORT_FROM=2026-04-25
# PR-2.3: trust proxy hops so req.ip honours X-Forwarded-For. 0 = no trust
# (single-host default). Set to 1 when running behind a single reverse proxy
# (e.g. Docker, nginx). Higher values trust that many proxy hops.
TRUST_PROXY=0

# ── Zálohy ──────────────────────────────────────────────────────────────────
# Kam pg_dump píše dennú zálohu (04:00 Bratislava). V dockeri je to named
# volume pos_backups, viď docker-compose.yml.
BACKUP_DIR=/backups
# Koľko dní snapshotov sa drží, staršie sa mažú.
BACKUP_RETENTION_DAYS=14
# DRUHÁ KÓPIA mimo pôvodného disku. Prázdne = vypnuté.
# Bez nej ležia živá DB aj všetkých 14 dní záloh na tom istom fyzickom disku,
# takže jeho zlyhanie vezme oboje naraz. Nastav na iný disk alebo na priečinok
# zdieľaný cez Tailscale z druhého stroja, napr.:
#   BACKUP_MIRROR_DIR=/mnt/zaloha-nas/pos
BACKUP_MIRROR_DIR=
